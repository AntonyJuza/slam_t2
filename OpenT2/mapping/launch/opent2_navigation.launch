<launch>
  <!-- ========================================================================= -->
  <!-- OpenT2 Autonomous Navigation Stack for Keenon T2 Service Robot            -->
  <!-- ========================================================================= -->
  <arg name="robot_type" default="T2" doc="Robot hardware platform type (T2)"/>
  <arg name="map_file" default="/home/peanut/maps/my_new_map_cropped.yaml" doc="Path to occupancy grid map YAML"/>
  <arg name="use_map_manager" default="true" doc="Use OpenT2 layered SQLite Map Manager instead of static map_server"/>
  <arg name="use_amcl" default="true" doc="Enable AMCL particle filter localization"/>
  <arg name="use_camera" default="false" doc="Enable dual Orbbec Astra depth cameras"/>
  <arg name="use_rviz" default="false" doc="Launch RViz visualization interface"/>

  <!-- 1. Keenon Chassis Driver (remapped to /cmd_vel_chassis so cmd_vel_inverter controls it) -->
  <node pkg="chassis" type="chassis" name="chassis" respawn="true" output="screen">
    <rosparam file="$(find robot_settings)/cfg/yaml/$(arg robot_type)/chassis_params.yaml" command="load"/>
    <remap from="/cmd_vel" to="/cmd_vel_chassis"/>
  </node>
  <include file="$(find robot_settings)/launch/include/robot_state_publisher.launch">
    <arg name="ROBOT_TYPE" value="$(arg robot_type)"/>
  </include>

  <!-- 2. Dual SDKELI LS-L100 Planar LiDAR Drivers (UDP Ethernet) -->
  <include file="$(find robot_settings)/launch/include/keli_2.launch">
    <arg name="ROBOT_TYPE" value="$(arg robot_type)"/>
  </include>

  <!-- 2b. Optional Depth Cameras (Disabled by default to save CPU/USB bandwidth) -->
  <include file="$(find robot_settings)/launch/include/astra_2.launch" if="$(arg use_camera)">
    <arg name="ROBOT_TYPE" value="$(arg robot_type)"/>
  </include>

  <!-- 3. Dual LiDAR Merging Filters -->
  <node name="multi_lidar_filter" pkg="lidar_filter" type="multi_lidar_filter" respawn="true" output="screen">
    <rosparam file="$(find robot_settings)/cfg/yaml/$(arg robot_type)/lidar_filter_params.yaml" command="load"/>
    <remap from="scan_orig_1" to="scan_front_orig"/>
    <remap from="scan_orig_2" to="scan_back_orig"/>
    <remap from="scan_filtered" to="scan"/>
  </node>

  <node name="multi_lidar_filter_for_planner" pkg="lidar_filter" type="multi_lidar_filter" respawn="true" output="screen">
    <rosparam file="$(find robot_settings)/cfg/yaml/$(arg robot_type)/lidar_filter_for_planner_params.yaml" command="load"/>
    <remap from="scan_orig_1" to="scan_front_orig"/>
    <remap from="scan_orig_2" to="scan_back_orig"/>
    <remap from="scan_filtered" to="planner_scan"/>
    <remap from="scan_orig" to="scan_orig_planner"/>
  </node>

  <!-- 3b. OpenT2 Scan Filter: Strips chassis self-reflections (<0.28m) -> outputs /scan_filtered -->
  <node name="scan_filter" pkg="open_t2_mapping" type="scan_filter.py" output="screen" respawn="true" />

  <!-- 4a. Encoder Inverter (Inverts linear travel while preserving yaw rotation) -->
  <node name="encoder_inverter" pkg="open_t2_mapping" type="encoder_inverter.py" output="screen" respawn="true" />

  <!-- 4b. Command Velocity Inverter (Inverts linear.x: /cmd_vel (+x forward) -> /cmd_vel_chassis (-x forward for Keenon motor)) -->
  <node name="cmd_vel_inverter" pkg="open_t2_mapping" type="cmd_vel_inverter.py" output="screen" respawn="true">
    <param name="invert_linear" value="true" />
    <param name="invert_angular" value="false" />
    <param name="output_topic" value="/cmd_vel_chassis" />
  </node>

  <!-- 4c. Front End Node (Wheel Odometry + Scan Matching -> odom to base_link TF) -->
  <node pkg="robot_location" type="front_end_node" name="front_end_node" respawn="true" clear_params="true" output="screen">
    <rosparam file="$(find robot_location)/launch/common_FrontEnd.yaml" command="load"/>
    <param name="encoder_topic" value="/encoder_raw_corrected" />
  </node>

  <node pkg="robot_location" type="srf_node" name="srf_node" respawn="true" clear_params="true" output="screen">
    <rosparam file="$(find robot_location)/launch/common_SRF.yaml" command="load"/>
  </node>

  <!-- 5a. OpenT2 Map Manager (Dynamic Layered SQLite Map Engine) -->
  <node name="opent2_map_manager" pkg="open_t2_mapping" type="opent2_map_manager.py" output="screen" respawn="true" if="$(arg use_map_manager)">
    <param name="maps_root" value="/home/peanut/opent2_maps" />
    <param name="default_map_id" value="default_floor" />
  </node>

  <!-- 5b. Legacy Static Map Server Fallback -->
  <node name="map_server" pkg="map_server" type="map_server" args="$(arg map_file)" output="screen" unless="$(arg use_map_manager)" />

  <!-- 6. AMCL Localization (Subscribes to /scan_filtered, broadcasts map to odom TF) -->
  <node pkg="amcl" type="amcl" name="amcl" respawn="true" output="screen" if="$(arg use_amcl)">
    <rosparam file="$(find open_t2_mapping)/config/navigation/amcl_params.yaml" command="load"/>
    <remap from="scan" to="scan_filtered" />
    <remap from="map" to="map_amcl" if="$(arg use_map_manager)" />
  </node>

  <!-- 7. Move Base Navigation Stack (GlobalPlanner + TEB Local Planner) -->
  <node pkg="move_base" type="move_base" name="move_base" respawn="true" output="screen">
    <remap from="cmd_vel" to="/cmd_vel_nav" />
    <remap from="move_base_simple/goal" to="move_base_simple/goal" />
    <param name="base_global_planner" value="global_planner/GlobalPlanner"/>
    <param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS"/>
    <rosparam file="$(find open_t2_mapping)/config/navigation/move_base_params.yaml" command="load"/>
    <rosparam file="$(find open_t2_mapping)/config/navigation/costmap_common_params.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find open_t2_mapping)/config/navigation/costmap_common_params.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find open_t2_mapping)/config/navigation/costmap_common_params.yaml" command="load" ns="function_costmap" />
    <rosparam file="$(find open_t2_mapping)/config/navigation/local_costmap_params.yaml" command="load" />
    <rosparam file="$(find open_t2_mapping)/config/navigation/global_costmap_params.yaml" command="load" />
    <rosparam file="$(find open_t2_mapping)/config/navigation/function_costmap_params.yaml" command="load" />
    <rosparam file="$(find open_t2_mapping)/config/navigation/teb_local_planner_params.yaml" command="load" />
  </node>

  <!-- 8. Rosbridge WebSocket Server for Android Tablet (Port 9090) -->
  <include file="$(find rosbridge_server)/launch/rosbridge_websocket.launch">
    <arg name="port" value="9090"/>
  </include>

  <!-- 8b. Web Backend Node (Compresses /map to /map/to_web/compressed for mobile UI) -->
  <node pkg="web_backend" type="web_backend_node" name="web_backend_node" respawn="true" output="screen" args="_image_transport:=compressed">
    <param name="web_map_save_path" value="/etc/ros/runtime/web_receive/map.pgm"/>
    <param name="web_virtual_wall_map_save_path" value="/etc/ros/runtime/web_receive/virtual_wall.pgm"/>
    <param name="maps_layer_path" value="/etc/ros/runtime/web/maps/layer.json"/>
  </node>

  <!-- 9. Optional RViz Visualization -->
  <node name="rviz" pkg="rviz" type="rviz" if="$(arg use_rviz)"
        args="-d $(find open_t2_mapping)/rviz/mapping.rviz" />
</launch>
